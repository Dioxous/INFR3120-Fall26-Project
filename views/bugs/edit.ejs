<%- include('../partials/header') %>

<main class="py-4">
    <div class="row justify-content-center mb-3">
      <h1 class="text-white text-center mb-3">Edit a Bug</h1>
      <div class="col-lg-10">
        <form class="row g-3 needs-validation justify-content-center" novalidate method="post"> 
          <div class="col-md-4">
            <label for="inputAppName" class="form-label">App Name</label>
            <input type="text" class="form-control" id="inputAppName" name="appName" value="<%= Bug.appName %>" required
              placeholder="App/site where bug was found">
          </div>
          <div class="col-md-2">
            <label for="inputSeverity" class="form-label">Severity</label>
            <select class="form-select" id="inputSeverity" name="severity" required>
              <option selected disabled value=""><%= Bug.severity %></option>
              <option>High</option>
              <option>Medium</option>
              <option>Low</option>
            </select>
          </div>
          <div class="col-md-4">
            <label for="inputBugTitle" class="form-label">Bug Title</label>
            <input type="text" class="form-control" id="inputBugTitle" name="title" value="<%= Bug.title %>" required
              placeholder="Brief description of bug">
          </div>
          <div class="col-md-10">
            <label for="inputDescription" class="form-label">Description</label>
            <textarea class="form-control" id="inputDescription" rows="5" name="description" required
              placeholder="Detailed description of the bug"><%= Bug.description %></textarea>
          </div>
          <div class="col-md-10">
            <button class="btn btn-primary me-2" type="submit">Submit form</button>
            <a class="btn btn-danger" href="/">Cancel</a>
          </div>
        </form>
      </div>
    </div>
</main>

<script>
    (function () {
      'use strict'

      // Fetch all the forms we want to apply custom Bootstrap validation styles to
      var forms = document.querySelectorAll('.needs-validation')

      // Loop over them and prevent submission
      Array.prototype.slice.call(forms)
        .forEach(function (form) {
          form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }

            form.classList.add('was-validated')
          }, false)
        })
    })()
</script>

<%- include('../partials/footer') %>