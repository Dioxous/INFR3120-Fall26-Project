<%- include('partials/header') %>

<main class="container py-4">
  <div class="row">
    <h1 class="text-center">Reported Bugs</h1>
    <button type="button" class="btn btn-primary">Primary</button>
    <div class="col-md-10 mx-auto">
      <table class="table table-bordered table-striped table-hover">
        <br>
        <tr>
          <th class="text-center col-2">App Name</th>
          <th class="text-center col-2">Severity</th>
          <th class="text-center col-2">Bug Title</th>
          <th class="text-center col-4">Description</th>
        </tr>
        <% for(let count = 0; count < allBugs.length; count++){ %>
            <tr>
              <td class="text-center col-2"><%= allBugs[count].appName %></td>
              <td class="text-center col-2"><%= allBugs[count].severity %></td>
              <td class="text-center col-2"><%= allBugs[count].title %></td>
              <td class="text-center col-2"><%= allBugs[count].description %></td>
            </tr>
        <% } %>
      </table>
    </div>
  </div>
</main>

<%- include('partials/footer') %>